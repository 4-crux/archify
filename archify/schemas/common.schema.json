{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tt-a1i/archify/schemas/common.schema.json",
  "title": "Archify Shared Definitions",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
    },
    "locale": {
      "enum": ["en", "zh-CN"]
    },
    "animation": {
      "enum": ["trace", "none"]
    },
    "visualPreset": {
      "enum": ["classic", "signal-flow", "blueprint", "editorial", "4crux"]
    },
    "diagramLogo": {
      "enum": ["4crux"]
    },
    "qualityProfile": {
      "enum": ["standard", "showcase"]
    },
    "side": {
      "enum": ["left", "right", "top", "bottom"]
    },
    "relationshipWidth": {
      "type": "number",
      "minimum": 0.5
    },
    "point": {
      "type": "array",
      "prefixItems": [
        { "type": "number" },
        { "type": "number" }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "componentType": {
      "enum": ["frontend", "backend", "database", "cloud", "security", "messagebus", "external"]
    },
    "brandMark": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "anyOf": [
            { "maxLength": 80, "pattern": "^[^\\r\\n]+$" },
            { "pattern": "^https?://" }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["url", "sha256"],
          "properties": {
            "url": { "type": "string", "minLength": 8, "maxLength": 2048, "pattern": "^https?://" },
            "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }
        }
      ]
    },
    "variant": {
      "enum": ["default", "emphasis", "security", "dashed"]
    },
    "legendMode": {
      "enum": ["auto", "all", "hidden"]
    },
    "legendEntry": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 80 },
        "visible": { "type": "boolean" }
      }
    },
    "guidedViews": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "focus"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "label": { "type": "string", "minLength": 1, "maxLength": 48 },
          "focus": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/id" }
          },
          "note": { "type": "string", "maxLength": 140 }
        }
      }
    },
    "cards": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dot", "title", "items"],
        "properties": {
          "dot": { "enum": ["cyan", "emerald", "violet", "amber", "rose", "orange", "slate"] },
          "title": { "type": "string", "minLength": 1 },
          "items": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "revision"],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+(?:\\.git)?/?$"
        },
        "revision": { "type": "string", "pattern": "^[a-fA-F0-9]{40}$" }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path"],
        "properties": {
          "path": { "type": "string", "minLength": 1, "maxLength": 240 },
          "line": { "type": "integer", "minimum": 1 },
          "end_line": { "type": "integer", "minimum": 1 },
          "label": { "type": "string", "minLength": 1, "maxLength": 48 }
        }
      }
    },
    "modelLayout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["grid"] },
        "origin": { "$ref": "common.schema.json#/$defs/point" },
        "cols": { "type": "integer", "minimum": 1, "maximum": 12 },
        "gapX": { "type": "number", "minimum": 16 },
        "gapY": { "type": "number", "minimum": 16 }
      }
    },
    "modelSide": {
      "enum": ["auto", "left", "right", "top", "bottom"]
    },
    "cardinality": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8,
      "pattern": "^[0-9*nN]+(\\.\\.[0-9*nN]+)?$"
    },
    "visibility": {
      "enum": ["public", "private", "protected", "package"]
    },
    "modelAttribute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 40 },
        "type": { "type": "string", "minLength": 1, "maxLength": 40 },
        "visibility": { "$ref": "common.schema.json#/$defs/visibility" },
        "static": { "type": "boolean" },
        "note": { "type": "string", "minLength": 1, "maxLength": 40 }
      }
    },
    "modelMethod": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 40 },
        "params": { "type": "string", "maxLength": 80 },
        "returns": { "type": "string", "minLength": 1, "maxLength": 40 },
        "visibility": { "$ref": "common.schema.json#/$defs/visibility" },
        "static": { "type": "boolean" }
      }
    },
    "modelColumn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 48 },
        "type": { "type": "string", "minLength": 1, "maxLength": 32 },
        "pk": { "type": "boolean" },
        "fk": { "type": "boolean" },
        "nullable": { "type": "boolean" },
        "unique": { "type": "boolean" },
        "ref": {
          "type": "string",
          "minLength": 3,
          "maxLength": 96,
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*\\.[A-Za-z_][A-Za-z0-9_]*$"
        }
      }
    },
    "modelLegend": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "$ref": "common.schema.json#/$defs/legendMode" },
        "entries": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "aggregate-root": { "$ref": "common.schema.json#/$defs/legendEntry" },
            "entity": { "$ref": "common.schema.json#/$defs/legendEntry" },
            "value-object": { "$ref": "common.schema.json#/$defs/legendEntry" },
            "enum": { "$ref": "common.schema.json#/$defs/legendEntry" },
            "domain-event": { "$ref": "common.schema.json#/$defs/legendEntry" },
            "domain-service": { "$ref": "common.schema.json#/$defs/legendEntry" },
            "table": { "$ref": "common.schema.json#/$defs/legendEntry" },
            "view": { "$ref": "common.schema.json#/$defs/legendEntry" },
            "junction": { "$ref": "common.schema.json#/$defs/legendEntry" }
          }
        }
      }
    }
  }
}
